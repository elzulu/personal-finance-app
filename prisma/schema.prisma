generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String?
  createdAt    DateTime     @default(now())
  movimientos  Movimiento[]
  miembros     Miembro[]
  deudas       Deuda[]
}

model Miembro {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  nombre      String
  createdAt   DateTime     @default(now())
  movimientos Movimiento[]
  deudas      Deuda[]

  @@index([userId])
}

enum Tipo {
  INGRESO
  EGRESO
}

enum TipoDeuda {
  TARJETA_CREDITO
  ADDI
  SISTECREDITO
  PRESTAMO_BANCARIO
  OTRO
}

model Deuda {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  miembroId   String?
  miembro     Miembro?     @relation(fields: [miembroId], references: [id])
  tipo        TipoDeuda
  descripcion String?
  monto       Decimal      @db.Decimal(12, 2)
  pagado      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  movimientos Movimiento[]

  @@index([userId])
  @@index([userId, miembroId])
}

model Movimiento {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  miembroId  String?
  miembro    Miembro? @relation(fields: [miembroId], references: [id])
  deudaId    String?
  deuda      Deuda?   @relation(fields: [deudaId], references: [id], onDelete: SetNull)
  fecha      DateTime
  tipo       Tipo
  categoria  String
  concepto   String
  monto      Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, fecha])
  @@index([userId, tipo, categoria])
  @@index([userId, miembroId])
  @@index([deudaId])
}
