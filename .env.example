# Base de datos PostgreSQL (Neon o Vercel Postgres)
# Formato Neon: postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/personal_finance?schema=public"

# NextAuth
# Generar con: openssl rand -base64 32
NEXTAUTH_SECRET="tu-secreto-aqui-generalo-con-openssl-rand-base64-32"
# En desarrollo: http://localhost:3000 | En produccion: tu URL de Vercel
NEXTAUTH_URL="http://localhost:3000"

# Recordatorios de pago (Web Push + Vercel Cron)
# Generar llaves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Opcional: contacto para los servicios de push (mailto: o URL). Por defecto usa NEXTAUTH_URL
VAPID_SUBJECT=""
# Secreto con el que Vercel Cron autentica la llamada al endpoint de recordatorios
CRON_SECRET=""
